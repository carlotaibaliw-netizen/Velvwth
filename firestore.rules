rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && 
                    incoming().role == 'user'; // Users register as 'user' by default
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
                    incoming().role == existing().role; // Role is immutable for the user
    }

    // --- Loans ---
    match /loans/{loanId} {
      allow read: if isSignedIn() && (isOwner(existing().borrowerId) || isAdmin());
      allow create: if isSignedIn() && (incoming().borrowerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isAdmin(); // Only admins can update loan status/balance
      allow delete: if isAdmin();
    }

    // --- Payments ---
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (isOwner(existing().borrowerId) || isAdmin());
      allow create: if isSignedIn() && (incoming().borrowerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isOwner(existing().userId) || existing().userId == 'admin' && isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    // --- Penalties ---
    match /penalties/{penaltyId} {
      allow read: if isSignedIn() && (isOwner(existing().borrowerId) || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
